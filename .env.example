BOT_TOKEN=
# Local SQLite: survives only as long as the host keeps this filesystem.
MEMORY_DB=/app/data/artifacts.sqlite3
# Optional free durable memory: create a libSQL database on Turso's Free plan.
# Set both privately in Render Environment; never commit a real token.
# Without these, the bot continues using MEMORY_DB on the local filesystem.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
MEMORY_DAYS=180
MEMORY_PER_HISTORY=512
MEMORY_TOTAL=8192
MEMORY_DONORS=16
# Spontaneous private-chat mixes, with a new random interval after each attempt.
MEMORY_DREAMS=true
DREAM_MIN_HOURS=6
DREAM_MAX_HOURS=30
MAX_UPLOAD_MB=20
MAX_OUTPUT_MB=48
MAX_PDF_PAGES=100
MAX_VIDEO_SECONDS=120
MAX_AUDIO_SECONDS=180

# Optional separately hosted Telegram Bot API server, run with --local.
# Share its files directory at the same absolute paths with the bot container.
# Stop the current bot and follow Telegram's logOut migration procedure first.
# BOT_API_URL=http://telegram-bot-api:8081
# BOT_API_LOCAL_FILES=true
# MAX_UPLOAD_MB=100
# MAX_OUTPUT_MB=100
